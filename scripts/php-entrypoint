#!/bin/bash

main() {
    echo "=========================================="
    echo "Starting Laravel application..."
    echo "Working directory: $(pwd)"
    echo "User: $(whoami)"
    echo "PHP version: $(php --version | head -1)"
    echo "=========================================="

    set -e

    echo "Step 1: Preparing storage..."
    prepare_storage

    echo "Step 2: Preparing file permissions..."
    prepare_file_permissions

    echo "Step 3: Running migrations..."
    run_migrations

    echo "Step 4: Optimizing app..."
    optimize_app

    echo "Step 5: Setting up scheduler..."
    setup_scheduler

    echo "Step 6: Starting Apache..."
    run_server "$@"
}

prepare_storage() {
    echo "Preparing Laravel storage directories..."

    mkdir -p /var/www/storage/framework/cache/data
    mkdir -p /var/www/storage/framework/sessions
    mkdir -p /var/www/storage/framework/views
    mkdir -p /var/www/storage/app/public
    mkdir -p /var/www/storage/logs
    mkdir -p /var/www/bootstrap/cache

    # Hand ownership of mutable paths to the web server user
    chown -R www-data:www-data \
        /var/www/storage \
        /var/www/bootstrap/cache

    # Create public/storage symlink if it doesn't already exist
    if [ ! -L "/var/www/public/storage" ]; then
        echo "Creating storage symlink..."
        php /var/www/artisan storage:link || echo "Warning: storage:link failed, continuing..."
    else
        echo "Storage symlink already exists, skipping..."
    fi
}

prepare_file_permissions() {
    if [ ! -x "/var/www/artisan" ]; then
        chmod a+x /var/www/artisan
    fi

    chmod -R 775 /var/www/storage 2>/dev/null || true
    chmod -R 775 /var/www/bootstrap/cache 2>/dev/null || true
}

run_migrations() {
    local attempts=10
    local wait_seconds=3

    for attempt in $(seq 1 "$attempts"); do
        if php /var/www/artisan migrate --force --no-interaction; then
            return 0
        fi

        if [ "$attempt" -eq "$attempts" ]; then
            echo "Migrations failed after $attempts attempts."
            return 1
        fi

        echo "Migrations failed. Retrying in ${wait_seconds}s... (${attempt}/${attempts})"
        sleep "$wait_seconds"
    done
}

optimize_app() {
    echo "Optimizing Laravel application..."
    php /var/www/artisan optimize:clear
    php /var/www/artisan optimize
}

setup_scheduler() {
    local scheduler_file="/etc/cron.d/laravel-scheduler"
    local scheduler_log="/var/www/storage/logs/scheduler.log"

    echo "Configuring Laravel scheduler cron job..."

    touch "$scheduler_log"
    chown www-data:www-data "$scheduler_log"

    cat > "$scheduler_file" <<'CRON'
* * * * * www-data cd /var/www && php artisan schedule:run >> /var/www/storage/logs/scheduler.log 2>&1
CRON

    chmod 0644 "$scheduler_file"

    echo "Starting cron daemon..."
    if command -v service >/dev/null 2>&1; then
        service cron start
    else
        cron
    fi
}

run_server() {
    exec apache2-foreground
}

main "$@"
